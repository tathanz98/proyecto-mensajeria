# Cadena de conexión PostgreSQL (local o remota, p. ej. Neon/Supabase para Vercel).
DATABASE_URL="postgresql://usuario:password@localhost:5432/mensajeria?schema=public"

# Secreto privado de al menos 32 bytes. Genera uno con:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=""

# Orígenes exactos del frontend separados por coma.
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:4173,http://localhost:4174"

# Identificador para el geocodificador Nominatim (OpenStreetMap).
GEOCODING_USER_AGENT="RutaColombia/1.0"

PORT=3000
